    \n" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}" "${0##*/}"
    exit 0
}

version_info() {
    printf "%s\n" "$version_number"
    exit 0
}

update_script() {
    printf "[branch:%s] Checking for Update..\n" "$branch"
    update="$(curl --fail-with-body -sL -A "$agent" "https://raw.githubusercontent.com/pystardust/ani-cli/$branch/ani-cli")" || die "[branch:$branch] Connection error: $update"
    printf '%s' "$update" | grep -q "^version_number" || die "[branch:$branch] Invalid Response."
    update="$(printf '%s\n' "$update" | diff -u "$0" -)"
    if [ -z "$update" ]; then
        printf "[branch:%s] Script is up to date :)\n" "$branch"
    else
        if printf '%s\n' "$update" | patch "$0" -; then
            printf "[branch:%s] Script has been updated\n" "$branch"
        else
            die "[branch:$branch] Can't update for some reason!"
        fi
    fi
    exit 0
}

# checks if dependencies are present
dep_ch() {
    for dep; do
        command -v "${dep%% *}" >/dev/null || die "Program \"${dep%% *}\" not found. Please install it."
    done
}

cleanup() {
    luna_webos_close
    printf "\033[0m" # clears colors
    rm -f "${histfile}.new" # remove temp logfile
}

# PLAYER (webOS luna-send-pub)

# JSON-escape a string: backslash, double-quote, and strip control chars
json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# Launches a URL in the built-in webOS "Media Discovery" player via luna-send-pub.
# $1 = playable URL   $2 = display/file title
luna_webos() {
    _url="$(json_escape "$1")"
    _title="$(json_escape "$2")"
    # mimeType is a best-effort guess; webOS's DLNA-style renderer mostly ignores
    # it for playback decisions but some builds use it for UI display.
    case "$1" in
        *.m3u8*) _mime="application/vnd.apple.mpegurl" ;;
        *.mkv*) _mime="video/x-matroska" ;;
        *) _mime="video/mp4" ;;
    esac
    luna-send-pub -n 1 -f luna://com.webos.applicationManager/launch \
        '{"id":"com.webos.app.mediadiscovery","params":{"payload":[{"fullPath":"'"$_url"'","artist":"","subtitle":"","dlnaInfo":{"flagVal":4096,"cleartextSize":"-1","contentLength":"-1","opVal":1,"protocolInfo":"http-get:*:'"$_mime"':DLNA.ORG_OP=01;DLNA.ORG_CI=0;DLNA.ORG_FLAGS=01700000000000000000000000000000","duration":0},"mediaType":"VIDEO","thumbnail":"","deviceType":"DMR","album":"","fileName":"'"$_title"'","lastPlayPosition":-1}]}}' \
        >/dev/null 2>&1 &
}

# Closes the media player app (called on quit/Ctrl-C via cleanup()).
luna_webos_close() {
    luna-send -n 1 -f luna://com.webos.service.applicationmanager/closeByAppId \
        '{"id":"com.webos.app.mediadiscovery"}' \
        >/dev/null 2>&1
}

# SCRAPING

# extract the video links from response of embed urls, extract mp4 links form m3u8 lists
get_links() {
    case "$*" in
        *mp4upload*)
            episode_link=$(curl --max-time 10 -sLk "$*" -A "$agent" -e "$allanime_refr" | sed -nE 's|.*src: "([^"]*)"[[:space:]]*|Mp4Upload >\1|p')
            ;;
        *tools.fast4speed.rsvp*)
            episode_link=$(printf "%s\n" "Yt >$*")
            ;;
        *)
            response="$(curl -e "$allanime_refr" -s "https://${allanime_base}$*" -A "$agent")"
            episode_link="$(printf '%s' "$response" | sed 's|},{|\
        |g' | sed -nE 's|.*link":"([^"]*)".*"resolutionStr":"([^"]*)".*|\2 >\1|p;s|.*hls","url":"([^"]*)".*"hardsub_lang":"en-US".*|\1|p')"
            ;;
    esac

    case "$episode_link" in
        *repackager.wixmp.com*)
            extract_link=$(printf "%s" "$episode_link" | cut -d'>' -f2 | sed 's|repackager.wixmp.com/||g;s|\.urlset.*||g')
            for j in $(printf "%s" "$episode_link" | sed -nE 's|.*/,([^/]*),/mp4.*|\1|p' | sed 's|,|\
|g'); do
                printf "%s >%s\n" "$j" "$extract_link" | sed "s|,[^/]*|${j}|g"
            done | sort -nr
            ;;
        *master.m3u8*)
            m3u8_refr=$(printf '%s' "$response" | sed -nE 's|.*Referer":"([^"]*)".*|\1|p') && printf '%s\n' "m3u8_refr >$m3u8_refr" >"$cache_dir/m3u8_refr"
            extract_link=$(printf "%s" "$episode_link" | head -1 | cut -d'>' -f2)
            relative_link=$(printf "%s" "$extract_link" | sed 's|[^/]*$||')
            m3u8_streams="$(curl -e "$m3u8_refr" -s "$extract_link" -A "$agent")"
            printf "%s" "$m3u8_streams" | grep -q "EXTM3U" && printf "%s" "$m3u8_streams" | sed 's|^#EXT-X-STREAM.*x||g; s|,.*|p|g; /^#/d; $!N; s|\n| >|;/EXT-X-I-FRAME/d' | sed "s|>|>${relative_link}|g" | sort -nr
            ;;
        *) [ -n "$episode_link" ] && printf "%s\n" "$episode_link" ;;
    esac
    printf "\033[1;32m%s\033[0m Links Fetched\n" "$provider_name" 1>&2
}

